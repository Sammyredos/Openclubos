# Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-password"
POSTGRES_DB="openclub"
# Note: Port 5433 is for direct Postgres access locally. Port 6432 is for PgBouncer access. 
# Append &pgbouncer=true if using PgBouncer.
DATABASE_URL="postgresql://postgres:your-secure-password@127.0.0.1:5433/openclub?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:your-secure-password@127.0.0.1:5433/openclub?schema=public"
DATABASE_URL_REPLICA="postgresql://postgres:your-secure-password@127.0.0.1:5434/openclub?schema=public"

# Redis (Split Instances: Dedicated Queue vs Cache/PubSub/Throttler)
QUEUE_REDIS_URL="redis://127.0.0.1:6380"
CACHE_REDIS_URL="redis://127.0.0.1:6379"
REDIS_URL="redis://127.0.0.1:6379"

# JWT (Refresh tokens are auto-generated as secure hashes and stored in Redis with a 7-day TTL)
# REQUIRED: The application will fail to start without a JWT_SECRET defined.
# Must be a secure random string (e.g., generated with openssl rand -base64 32).
JWT_SECRET="your-super-secret-key"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
FRONTEND_URL="http://localhost:3000"

# Firebase
FCM_SERVER_KEY="your-fcm-key"

# Payments
PAYSTACK_SECRET_KEY="sk_test_..."
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."

# Storage
AWS_S3_BUCKET="openclub-assets"
AWS_ACCESS_KEY="your-access-key"
AWS_SECRET_KEY="your-secret-key"
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY="your-r2-access-key"
R2_SECRET_KEY="your-r2-secret-key"
R2_BUCKET="openclub-assets"
CDN_BASE_URL="https://cdn.openclubos.com"

# Email / SMTP
# Leave commented out for local dev (defaults to Mailpit on localhost:1025)
# Uncomment and configure for production (cPanel, SendGrid, AWS SES, etc.)
# SMTP_HOST="mail.yourdomain.com"
# SMTP_PORT=587
# SMTP_USER="noreply@yourdomain.com"
# SMTP_PASS="your-email-password"
# SMTP_FROM_NAME="OpenClubOS"
# SMTP_FROM_ADDRESS="noreply@yourdomain.com"

# gRPC Microservice Lockdown
GRPC_URL="127.0.0.1:50051"
GRPC_AUTH_TOKEN="openclub-internal-grpc-secret-token"

# Bull Board Queue Monitoring Security
ENABLE_BULL_BOARD="true"
BULL_BOARD_USER="admin"
BULL_BOARD_PASS="openclub-secret-queues-2026"

# Mailpit (local email testing — Web UI)
MAILPIT_WEB_PORT=8025

# Node Environment
NODE_ENV="development"
FRONTEND_PORT=3000
BACKEND_PORT=3001
