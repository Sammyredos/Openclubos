# Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-password"
POSTGRES_DB="openclub"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (Refresh tokens are auto-generated as secure hashes and stored in Redis with a 7-day TTL)
JWT_SECRET="your-super-secret-key"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
FRONTEND_URL="http://localhost:3000"

# Firebase
FCM_SERVER_KEY="your-fcm-key"

# Payments
PAYSTACK_SECRET_KEY="sk_test_..."
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."

# Storage
AWS_S3_BUCKET="openclub-assets"
AWS_ACCESS_KEY="your-access-key"
AWS_SECRET_KEY="your-secret-key"
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY="your-r2-access-key"
R2_SECRET_KEY="your-r2-secret-key"
R2_BUCKET="openclub-assets"
CDN_BASE_URL="https://cdn.openclubos.com"

# Email / SMTP
# Leave commented out for local dev (defaults to Mailpit on localhost:1025)
# Uncomment and configure for production (cPanel, SendGrid, AWS SES, etc.)
# SMTP_HOST="mail.yourdomain.com"
# SMTP_PORT=587
# SMTP_USER="noreply@yourdomain.com"
# SMTP_PASS="your-email-password"
# SMTP_FROM_NAME="OpenClubOS"
# SMTP_FROM_ADDRESS="noreply@yourdomain.com"

# Mailpit (local email testing — Web UI)
MAILPIT_WEB_PORT=8025

# Node Environment
NODE_ENV="development"
FRONTEND_PORT=3000
BACKEND_PORT=3001
