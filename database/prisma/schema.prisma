// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String
  firstName    String?
  lastName     String?
  role         UserRole     @default(PLAYER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  profilePhoto String?
  phone        String?
  status       MemberStatus @default(ACTIVE)
  handicap     Float        @default(0.0)
  dob          String?
  gender       Gender?
  state        String?
  city         String?
  address      String?

  // Manager invitation
  inviteToken        String?
  inviteTokenExpires DateTime?
  managerScope       String?

  // Password reset
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Email verification
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  // AI Usage Tracking
  aiTournamentDescCount   Int       @default(0)
  aiTournamentDescResetAt DateTime?

  // Relations
  club          Club?          @relation(fields: [clubId], references: [id])
  clubId        String?
  scores        Score[]
  registrations Registration[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]

  @@index([clubId])
  @@index([role])
  @@index([firstName, lastName])
  @@index([email])
  @@index([email, deletedAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([updatedAt])
}

enum MemberStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
}

enum UserRole {
  SUPER_ADMIN
  CLUB_ADMIN
  STAFF
  PLAYER
  MARKER
  MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GenderRestriction {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

enum ClubStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum ClubPlan {
  PRO
  BASIC
}

model Club {
  id        String     @id @default(uuid())
  name      String
  address   String?
  state     String?
  city      String?
  logo      String?
  status    ClubStatus @default(ACTIVE)
  plan      ClubPlan   @default(BASIC)
  type      String?    @default("Golf Club")
  website   String?
  about     String?
  facebook  String?
  instagram String?
  country   String?    @default("NG")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  // Relations
  users        User[]
  tournaments  Tournament[]
  subscriptions Subscription[]

  @@index([createdAt])
  @@index([deletedAt])
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

model Course {
  id          String  @id @default(uuid())
  name        String
  alsoKnownAs String?
  type        String  @default("Parkland")
  country     String  @default("NG")
  state       String?
  city        String?

  address   String?
  latitude  Float?
  longitude Float?

  holesCount      Int     @default(18)
  par             Int     @default(72)
  yearEstablished Int?
  architect       String?
  courseRating    Float?
  slopeRating     Int?

  phone      String?
  email      String?
  website    String?
  bookingUrl String?

  amenities     String[] @default([])
  coverImage    String?
  galleryImages String[] @default([])

  status     CourseStatus @default(ACTIVE)
  isFeatured Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  holes       Hole[]
  teeBoxes    TeeBox[]
  tournaments Tournament[]
}

model TeeBox {
  id      String @id @default(uuid())
  name    String
  color   String
  yardage Int
  rating  Float?
  slope   Int?

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
}

model Hole {
  id        String   @id @default(uuid())
  number    Int
  par       Int
  index     Int?
  distance  Int? // In meters/yards
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course   Course  @relation(fields: [courseId], references: [id])
  courseId String
  scores   Score[]
}

enum TournamentStartType {
  TEE_TIMES
  SHOTGUN
}

model Tournament {
  id        String           @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  status    TournamentStatus @default(DRAFT)

  // Step 1: Basic Details
  description String?
  bannerUrl   String?
  venue       String?
  location    String?

  // Step 2: Schedule (startDate and endDate exist)
  registrationOpenAt  DateTime?
  registrationCloseAt DateTime? // Replaces registrationDeadline

  // Step 3: Format
  format      TournamentFormat @default(STROKE_PLAY)
  scoringType ScoringType      @default(BOTH)
  holes       Int              @default(18)

  // Step 4: Eligibility
  allowRegisteredPlayers Boolean  @default(true)
  allowGuests            Boolean  @default(false)
  allowExternalPlayers   Boolean  @default(false)
  hasHandicapRestriction Boolean  @default(false)
  minHandicap            Float?
  maxHandicap            Float?
  playerTypes            String[] @default(["MEMBER"])
  genderRestriction      GenderRestriction @default(MIXED)

  // Cut Rules
  enableCut     Boolean @default(false)
  cutAfterRound Int?
  cutLine       Int?

  // Step 5: Player Limits
  maxPlayers         Int?
  maxPlayersPerGroup Int     @default(4)
  enableWaitlist     Boolean @default(false)

  // Step 6: Payments
  requiresPayment Boolean   @default(false)
  entryFee        Float?
  currency        String    @default("NGN")
  paymentDeadline DateTime?
  isRefundable    Boolean   @default(false)

  // Step 7: Divisions
  divisions String[] @default([])

  // Step 8: Grouping Settings
  autoGrouping       Boolean @default(false)
  startType          TournamentStartType @default(TEE_TIMES)
  teeStartTime       String?
  teeIntervalMinutes Int     @default(10)

  // Step 9: Scoring Settings
  enableLiveScoring         Boolean @default(false)
  requireMarkerVerification Boolean @default(false)
  enableHoleScoring         Boolean @default(true)

  // Step 10: Publication Settings
  publishImmediately Boolean              @default(false)
  visibility         TournamentVisibility @default(PUBLIC)

  // Tracking
  emailLogs           TournamentEmailLog[]
  lockedGroupingsDays Int[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  club          Club           @relation(fields: [clubId], references: [id])
  clubId        String
  course        Course         @relation(fields: [courseId], references: [id])
  courseId      String
  registrations Registration[]
  groups        Group[]

  @@unique([clubId, name])
  @@index([clubId])
  @@index([status])
  @@index([name])
  @@index([startDate, status])
  @@index([endDate, status])
  @@index([clubId, createdAt])
  @@index([clubId, status])
  @@index([createdAt])
  @@index([deletedAt])
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  STROKE_PLAY
  MATCH_PLAY
  STABLEFORD
  SCRAMBLE
  BEST_BALL
}

enum ScoringType {
  GROSS
  NET
  BOTH
}

enum TournamentVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

model Registration {
  id               String             @id @default(uuid())
  registeredAt     DateTime           @default(now())
  status           RegistrationStatus @default(PENDING)
  paymentStatus    PaymentStatus      @default(UNPAID)
  playerType       String? // MEMBER, EXTERNAL, GUEST
  paymentReference String?
  extraStrokes     Int                @default(0)
  madeCut          Boolean? // null = pending/no cut, true = advanced, false = missed cut

  // Relations
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@index([tournamentId, status])
  @@index([userId, status])
  @@index([tournamentId, paymentStatus])
  @@index([registeredAt])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  DISQUALIFIED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Group {
  id        String    @id @default(uuid())
  name      String?
  startTime DateTime?

  // Relations
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String
  scores       Score[]
}

model Score {
  id         String   @id @default(uuid())
  strokes    Int
  putts      Int?
  points     Int? // Stableford points
  recordedAt DateTime @default(now())

  status      ScoreStatus @default(ENTERED)
  markerId    String?
  confirmedAt DateTime?

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  userId  String
  hole    Hole    @relation(fields: [holeId], references: [id])
  holeId  String
  group   Group?  @relation(fields: [groupId], references: [id])
  groupId String?

  @@unique([userId, holeId, groupId])
  @@index([userId])
  @@index([groupId])
  @@index([holeId])
  @@index([groupId, userId])
  @@index([recordedAt])
}

enum ScoreStatus {
  ENTERED
  CONFIRMED
  LOCKED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model TournamentEmailLog {
  id             String     @id @default(uuid())
  tournamentId   String
  emailType      String     // 'REMINDER', 'STARTED', 'COMPLETED'
  sentAt         DateTime   @default(now())
  recipientCount Int

  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([emailType])
  @@index([tournamentId, emailType])
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  amount         Float
  currency       String   @default("NGN")
  billingCycle   String   @default("MONTHLY") // MONTHLY, ANNUAL
  targetAudience String   @default("ORGANIZER") // ORGANIZER, PLAYER
  features       String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions  Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  clubId             String?
  userId             String?
  subscriptionPlanId String
  status             SubscriptionStatus @default(ACTIVE)
  nextBillingDate    DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  club             Club?            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  @@index([clubId])
  @@index([userId])
  @@index([subscriptionPlanId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}
