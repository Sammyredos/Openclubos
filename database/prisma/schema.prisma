// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  role          UserRole  @default(PLAYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  profilePhoto  String?
  phone         String?
  status        MemberStatus @default(ACTIVE)
  handicap      Float        @default(0.0)
  dob           String?
  gender        Gender?
  state         String?
  city          String?
  address       String?

  // Password reset
  passwordResetToken String?

  // Email verification
  emailVerified      Boolean   @default(false)
  emailVerificationToken String?

  // Relations
  club          Club?     @relation(fields: [clubId], references: [id])
  clubId        String?
  scores        Score[]
  registrations Registration[]

  @@index([clubId])
  @@index([role])
  @@index([firstName, lastName])
  @@index([email])
}

enum MemberStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  CLUB_ADMIN
  STAFF
  PLAYER
  MARKER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ClubStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum ClubPlan {
  PRO
  BASIC
}

model Club {
  id          String    @id @default(uuid())
  name        String
  address     String?
  state       String?
  city        String?
  logo        String?
  status      ClubStatus @default(ACTIVE)
  plan        ClubPlan   @default(BASIC)
  type        String?    @default("Golf Club")
  website     String?
  about       String?
  facebook    String?
  instagram   String?
  country     String?    @default("NG")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  users       User[]
  tournaments Tournament[]
  courses     Course[]
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

model Course {
  id              String       @id @default(uuid())
  name            String
  alsoKnownAs     String?
  type            String       @default("Parkland")
  country         String       @default("NG")
  state           String?
  city            String?

  address         String?
  latitude        Float?
  longitude       Float?

  holesCount      Int          @default(18)
  par             Int          @default(72)
  yearEstablished Int?
  architect       String?
  courseRating    Float?
  slopeRating     Int?

  phone           String?
  email           String?
  website         String?
  bookingUrl      String?

  amenities       String[]     @default([])
  coverImage      String?
  galleryImages   String[]     @default([])

  status          CourseStatus @default(ACTIVE)
  isFeatured      Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  club            Club?        @relation(fields: [clubId], references: [id])
  clubId          String?
  holes           Hole[]
  teeBoxes        TeeBox[]
  tournaments     Tournament[]
}

model TeeBox {
  id        String  @id @default(uuid())
  name      String
  color     String
  yardage   Int
  rating    Float?
  slope     Int?

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
}

model Hole {
  id          String    @id @default(uuid())
  number      Int
  par         Int
  index       Int?
  distance    Int?      // In meters/yards
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  course      Course    @relation(fields: [courseId], references: [id])
  courseId    String
  scores      Score[]
}

model Tournament {
  id          String    @id @default(uuid())
  name        String
  startDate   DateTime
  endDate     DateTime?
  status      TournamentStatus @default(DRAFT)
  
  // Step 1: Basic Details
  description          String?
  bannerUrl            String?
  venue                String?
  location             String?

  // Step 2: Schedule (startDate and endDate exist)
  registrationOpenAt   DateTime?
  registrationCloseAt  DateTime? // Replaces registrationDeadline

  // Step 3: Format
  format               TournamentFormat @default(STROKE_PLAY)
  scoringType          ScoringType      @default(GROSS)
  holes                Int              @default(18)

  // Step 4: Eligibility
  allowRegisteredPlayers Boolean        @default(true)
  allowGuests          Boolean          @default(false)
  allowExternalPlayers Boolean          @default(false)
  hasHandicapRestriction Boolean        @default(false)
  minHandicap          Float?
  maxHandicap          Float?
  playerTypes          String[]         @default(["MEMBER"])

  // Step 5: Player Limits
  maxPlayers           Int?
  maxPlayersPerGroup   Int              @default(4)
  enableWaitlist       Boolean          @default(false)

  // Step 6: Payments
  requiresPayment      Boolean          @default(false)
  entryFee             Float?
  currency             String           @default("NGN")
  paymentDeadline      DateTime?
  isRefundable         Boolean          @default(false)

  // Step 7: Divisions
  divisions            String[]         @default([])

  // Step 8: Grouping Settings
  autoGrouping         Boolean          @default(false)
  teeStartTime         String?
  teeIntervalMinutes   Int              @default(10)

  // Step 9: Scoring Settings
  enableLiveScoring    Boolean          @default(false)
  requireMarkerVerification Boolean     @default(false)
  enableHoleScoring    Boolean          @default(true)

  // Step 10: Publication Settings
  publishImmediately   Boolean          @default(false)
  visibility           TournamentVisibility @default(PUBLIC)

  // Tracking
  emailsSent           Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  club        Club      @relation(fields: [clubId], references: [id])
  clubId      String
  course      Course    @relation(fields: [courseId], references: [id])
  courseId    String
  registrations Registration[]
  groups      Group[]

  @@index([clubId])
  @@index([status])
  @@index([name])
  @@index([startDate, status])
  @@index([clubId, createdAt])
  @@index([clubId, status])
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  STROKE_PLAY
  MATCH_PLAY
  STABLEFORD
  SCRAMBLE
  BEST_BALL
}

enum ScoringType {
  GROSS
  NET
}

enum TournamentVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

model Registration {
  id               String    @id @default(uuid())
  registeredAt     DateTime  @default(now())
  status           RegistrationStatus @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  playerType       String?   // MEMBER, EXTERNAL, GUEST
  paymentReference String?
  extraStrokes     Int       @default(0)

  // Relations
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId  String

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@index([tournamentId, status])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  DISQUALIFIED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Group {
  id            String    @id @default(uuid())
  name          String?
  startTime     DateTime?

  // Relations
  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId  String
  scores        Score[]
}

model Score {
  id            String    @id @default(uuid())
  strokes       Int
  putts         Int?
  points        Int?      // Stableford points
  recordedAt    DateTime  @default(now())

  status        ScoreStatus @default(ENTERED)
  markerId      String?
  confirmedAt   DateTime?

  // Relations
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  hole          Hole      @relation(fields: [holeId], references: [id])
  holeId        String
  group         Group?    @relation(fields: [groupId], references: [id])
  groupId       String?

  @@unique([userId, holeId, groupId])
  @@index([userId])
  @@index([groupId])
  @@index([holeId])
  @@index([groupId, userId])
}

enum ScoreStatus {
  ENTERED
  CONFIRMED
  LOCKED
}
